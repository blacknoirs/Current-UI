local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Library = {}
local Window = {}
local Tab = {}
local Page = {}
local Section = {}

Window.__index = Window
Tab.__index = Tab
Page.__index = Page
Section.__index = Section

local Theme = {
	Background = Color3.fromRGB(14, 14, 17),
	Sidebar = Color3.fromRGB(10, 10, 13),
	Card = Color3.fromRGB(20, 20, 24),
	Border = Color3.fromRGB(36, 36, 42),
	SearchBorder = Color3.fromRGB(90, 90, 112),
	Control = Color3.fromRGB(30, 30, 36),
	Text = Color3.fromRGB(214, 214, 220),
	Muted = Color3.fromRGB(120, 120, 132),
	Accent = Color3.fromRGB(157, 142, 224),
	White = Color3.new(1, 1, 1),
}

local Fonts = {
	Regular = Enum.Font.Gotham,
	Medium = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
}

local Layout = {
	WindowWidth = 816,
	WindowHeight = 462,
	TopBarHeight = 38,
	SidebarWidth = 152,
	RowHeight = 30,
	SliderRowHeight = 46,
	DropdownWidth = 90,
	DropdownItemHeight = 22,
}

local MouseButton1 = Enum.UserInputType.MouseButton1
local MouseMovement = Enum.UserInputType.MouseMovement
local Touch = Enum.UserInputType.Touch

local function create(className, properties, parent)
	local instance = Instance.new(className)
	for property, value in pairs(properties) do
		instance[property] = value
	end
	instance.Parent = parent
	return instance
end

local function addCorner(instance, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 4) }, instance)
end

local function addStroke(instance, color)
	return create("UIStroke", {
		Color = color or Theme.Border,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, instance)
end

local function addPadding(instance, top, bottom, left, right)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
	}, instance)
end

local function createLabel(parent, text, properties)
	local labelProperties = {
		BackgroundTransparency = 1,
		Text = text,
		Font = Fonts.Regular,
		TextSize = 11,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for property, value in pairs(properties or {}) do
		labelProperties[property] = value
	end
	return create("TextLabel", labelProperties, parent)
end

local function isPressInput(input)
	return input.UserInputType == MouseButton1 or input.UserInputType == Touch
end

local function isMoveInput(input)
	return input.UserInputType == MouseMovement or input.UserInputType == Touch
end

local function formatInputName(inputEnum)
	local name = inputEnum.Name:gsub("MouseButton", "M")
	return "[" .. name .. "]"
end

local function createColumn(parent, scaleX, offsetX, widthOffset)
	local column = create("Frame", {
		Position = UDim2.new(scaleX, offsetX, 0, 0),
		Size = UDim2.new(0.5, widthOffset, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, parent)
	create("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, column)
	return column
end

local function openDropdownList(window, anchor, options, selected, onSelect)
	local overlay = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 50,
	}, window.Main)

	local offsetX = anchor.AbsolutePosition.X - window.Main.AbsolutePosition.X + anchor.AbsoluteSize.X - Layout.DropdownWidth
	local offsetY = anchor.AbsolutePosition.Y - window.Main.AbsolutePosition.Y + anchor.AbsoluteSize.Y - 4

	local list = create("Frame", {
		Position = UDim2.fromOffset(offsetX, offsetY),
		Size = UDim2.fromOffset(Layout.DropdownWidth, #options * Layout.DropdownItemHeight + 8),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		ZIndex = 51,
	}, overlay)
	addCorner(list)
	addStroke(list)

	for index, option in ipairs(options) do
		local item = create("TextButton", {
			Position = UDim2.fromOffset(0, 4 + (index - 1) * Layout.DropdownItemHeight),
			Size = UDim2.new(1, 0, 0, Layout.DropdownItemHeight),
			BackgroundTransparency = 1,
			Text = option,
			Font = Fonts.Regular,
			TextSize = 10,
			TextColor3 = option == selected and Theme.Accent or Theme.Text,
			ZIndex = 52,
		}, list)
		item.MouseButton1Click:Connect(function()
			overlay:Destroy()
			onSelect(option)
		end)
	end

	overlay.MouseButton1Click:Connect(function()
		overlay:Destroy()
	end)
end

function Library:CreateWindow(options)
	options = options or {}

	local window = setmetatable({
		Tabs = {},
		ActiveTab = nil,
		SearchRows = {},
		Connections = {},
	}, Window)

	window.Gui = create("ScreenGui", {
		Name = "UILibrary",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))

	window.Main = create("Frame", {
		Size = UDim2.fromOffset(Layout.WindowWidth, Layout.WindowHeight),
		Position = UDim2.new(0.5, -Layout.WindowWidth / 2, 0.5, -Layout.WindowHeight / 2),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, window.Gui)
	addCorner(window.Main, 6)
	addStroke(window.Main)

	window:BuildTopBar(options)
	window:BuildSidebar(options)
	window:EnableDragging()
	window:EnableToggleKey(options.Key or Enum.KeyCode.RightShift)

	return window
end

function Window:Connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.Connections, connection)
	return connection
end

