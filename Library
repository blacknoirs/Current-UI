function Window:EnableDragging()
	local isDragging = false
	local dragStart
	local startPosition

	self.TopBar.InputBegan:Connect(function(input)
		if isPressInput(input) then
			isDragging = true
			dragStart = input.Position
			startPosition = self.Main.Position
		end
	end)

	self:Connect(UserInputService.InputChanged, function(input)
		if isDragging and isMoveInput(input) then
			local viewport = self.Gui.AbsoluteSize
			local delta = input.Position - dragStart
			self.Main.Position = UDim2.new(
				math.clamp(startPosition.X.Scale + delta.X / viewport.X, 0, 1),
				0,
				math.clamp(startPosition.Y.Scale + delta.Y / viewport.Y, 0, 1),
				0
			)
		end
	end)

	self:Connect(UserInputService.InputEnded, function(input)
		if isPressInput(input) then
			isDragging = false
		end
	end)
end

function Window:EnableToggleKey()
	self:Connect(UserInputService.InputBegan, function(input, processed)
		if not processed and input.KeyCode == self.ToggleKey then
			self:Toggle()
		end
	end)
end

function Window:SetToggleKey(keyCode)
	self.ToggleKey = keyCode
end

function Window:SetVisible(visible)
	self.Main.Visible = visible
end

function Window:Toggle()
	self:SetVisible(not self.Main.Visible)
end

function Window:BuildToggleButton(options)
	local setting = options.ToggleButton
	if setting == nil then
		setting = UserInputService.TouchEnabled
	end
	if not setting then
		return
	end

	self.ToggleButton = create("Frame", {
		Position = options.ToggleButtonPosition or UDim2.new(0, 16, 0, 64),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		ZIndex = 20,
	}, self.Gui)
	addCorner(self.ToggleButton, 10)
	addStroke(self.ToggleButton, Theme.Accent)

	for index = 0, 2 do
		local bar = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 13 + index * 7),
			Size = UDim2.fromOffset(18, 2),
			BackgroundColor3 = Theme.White,
			BorderSizePixel = 0,
			ZIndex = 21,
		}, self.ToggleButton)
		addCorner(bar, 1)
	end

	local hitbox = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 22,
	}, self.ToggleButton)

	local isPressing = false
	local wasMoved = false
	local pressStart
	local startPosition

	hitbox.InputBegan:Connect(function(input)
		if isPressInput(input) then
			isPressing = true
			wasMoved = false
			pressStart = input.Position
			startPosition = self.ToggleButton.Position
		end
	end)

	self:Connect(UserInputService.InputChanged, function(input)
		if isPressing and isMoveInput(input) then
			local delta = input.Position - pressStart
			if delta.Magnitude > 6 then
				wasMoved = true
			end
			if wasMoved then
				local viewport = self.Gui.AbsoluteSize
				self.ToggleButton.Position = UDim2.new(
					startPosition.X.Scale + delta.X / viewport.X,
					startPosition.X.Offset,
					startPosition.Y.Scale + delta.Y / viewport.Y,
					startPosition.Y.Offset
				)
			end
		end
	end)

	self:Connect(UserInputService.InputEnded, function(input)
		if isPressing and isPressInput(input) then
			isPressing = false
			if not wasMoved then
				self:Toggle()
			end
		end
	end)
end

function Window:ApplySearch(query)
	query = query:lower()
	for _, section in ipairs(self.Sections) do
		local titleMatches = section.Title:find(query, 1, true) ~= nil
		local anyVisible = false
		for _, row in ipairs(section.Rows) do
			local visible = query == "" or titleMatches or row.Text:find(query, 1, true) ~= nil
			row.Frame.Visible = visible
			anyVisible = anyVisible or visible
		end
		section.Frame.Visible = query == "" or anyVisible
	end
end

function Window:Refresh()
	for _, tab in ipairs(self.Tabs) do
		local isActiveTab = tab == self.ActiveTab
		tween(tab.Button, { TextColor3 = isActiveTab and Theme.White or Theme.Muted }, 0.15)
		tab.Underline.Visible = isActiveTab
		tab.Sidebar.Visible = isActiveTab

		for _, page in ipairs(tab.Pages) do
			local isActivePage = page == tab.ActivePage
			page.Frame.Visible = isActiveTab and isActivePage
			page.Indicator.Visible = isActivePage
			page.Button.TextColor3 = isActivePage and Theme.Accent or Theme.Muted
		end
	end
end

function Window:SetWatermarkVisible(visible)
	if self.Watermark then
		self.Watermark.Visible = visible
	end
end

function Window:Notify(options)
	local duration = options.Duration or 4

	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, self.NotificationHolder)
	addCorner(card, 5)
	addStroke(card)

	local content = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, card)
	addPadding(content, 8, 12, 14, 12)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, content)

	createLabel(content, options.Title or "Notification", {
		Size = UDim2.new(1, 0, 0, 18),
		Font = Fonts.Medium,
		TextSize = 13,
		TextColor3 = Theme.White,
	})

	createLabel(content, options.Text or "", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextColor3 = Theme.Muted,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	create("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, card)

	local timerBar = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, card)

	tween(timerBar, { Size = UDim2.new(0, 0, 0, 2) }, duration)

	task.delay(duration, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function Window:Destroy()
	for _, connection in ipairs(self.Connections) do
		connection:Disconnect()
	end
	self.Gui:Destroy()
end

