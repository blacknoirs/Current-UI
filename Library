function Section:AddButton(text, callback)
	local row = self:CreateRow(Layout.RowHeight, text)
	local button = create("TextButton", {
		Position = UDim2.fromOffset(0, 3),
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = Theme.Control,
		Text = text,
		Font = Fonts.Regular,
		TextSize = 12,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, row)
	addCorner(button, 4)

	button.MouseEnter:Connect(function()
		tween(button, { BackgroundColor3 = Theme.Accent, TextColor3 = Theme.White }, 0.12)
	end)
	button.MouseLeave:Connect(function()
		tween(button, { BackgroundColor3 = Theme.Control, TextColor3 = Theme.Text }, 0.12)
	end)
	button.MouseButton1Click:Connect(function()
		if callback then
			callback()
		end
	end)
end

function Section:AddToggle(text, default, callback)
	local row = self:CreateRow(Layout.RowHeight, text)
	local toggle = { Value = default and true or false }

	local checkbox = create("Frame", {
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = toggle.Value and Theme.Accent or Theme.Control,
		BorderSizePixel = 0,
	}, row)
	addCorner(checkbox, 3)

	local label = createLabel(row, text, {
		Position = UDim2.fromOffset(22, 0),
		Size = UDim2.new(1, -22, 1, 0),
	})

	local hitbox = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	function toggle:Set(value)
		self.Value = value
		tween(checkbox, { BackgroundColor3 = value and Theme.Accent or Theme.Control }, 0.12)
		if callback then
			callback(value)
		end
	end

	hitbox.MouseEnter:Connect(function()
		tween(label, { TextColor3 = Theme.White }, 0.1)
	end)
	hitbox.MouseLeave:Connect(function()
		tween(label, { TextColor3 = Theme.Text }, 0.1)
	end)
	hitbox.MouseButton1Click:Connect(function()
		toggle:Set(not toggle.Value)
	end)

	return toggle
end

function Section:AddSlider(text, min, max, default, suffix, decimals, callback)
	local window = self.Window
	local row = self:CreateRow(Layout.SliderRowHeight, text)
	local valueFormat = "%." .. (decimals or 0) .. "f"
	local precision = 10 ^ (decimals or 0)
	local slider = { Value = default }

	createLabel(row, text, {
		Size = UDim2.new(0.6, 0, 0, 24),
	})

	local valueLabel = createLabel(row, string.format(valueFormat, default) .. (suffix or ""), {
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Muted,
		TextSize = 11,
	})

	local track = create("Frame", {
		Position = UDim2.fromOffset(0, 33),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = Theme.Track,
		BorderSizePixel = 0,
	}, row)
	addCorner(track, 3)

	local fill = create("Frame", {
		Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, track)
	addCorner(fill, 3)

	local hitbox = create("TextButton", {
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	function slider:Set(value)
		value = math.clamp(value, min, max)
		value = math.floor(value * precision + 0.5) / precision
		self.Value = value
		fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
		valueLabel.Text = string.format(valueFormat, value) .. (suffix or "")
		if callback then
			callback(value)
		end
	end

	local function setFromPosition(positionX)
		local alpha = math.clamp((positionX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		slider:Set(min + (max - min) * alpha)
	end

	local isDragging = false

	hitbox.InputBegan:Connect(function(input)
		if isPressInput(input) then
			isDragging = true
			setFromPosition(input.Position.X)
		end
	end)

	window:Connect(UserInputService.InputChanged, function(input)
		if isDragging and isMoveInput(input) then
			setFromPosition(input.Position.X)
		end
	end)

	window:Connect(UserInputService.InputEnded, function(input)
		if isPressInput(input) then
			isDragging = false
		end
	end)

	return slider
end

function Section:AddDropdown(text, options, default, callback)
	local window = self.Window
	local row = self:CreateRow(Layout.RowHeight, text)
	local dropdown = { Value = default or options[1] }

	createLabel(row, text, {
		Size = UDim2.new(0.6, 0, 1, 0),
	})

	local function formatValue(value)
		return value .. ' <font size="8">▼</font>'
	end

	local button = create("TextButton", {
		Position = UDim2.new(1, -70, 0, 0),
		Size = UDim2.fromOffset(70, Layout.RowHeight),
		BackgroundTransparency = 1,
		Text = formatValue(dropdown.Value),
		RichText = true,
		Font = Fonts.Regular,
		TextSize = 11,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)

	function dropdown:Set(value)
		self.Value = value
		button.Text = formatValue(value)
		if callback then
			callback(value)
		end
	end

	button.MouseButton1Click:Connect(function()
		openDropdownList(window, button, options, dropdown.Value, function(option)
			dropdown:Set(option)
		end)
	end)

	return dropdown
end

function Section:AddKeybind(text, default, callback, onChanged)
	local window = self.Window
	local row = self:CreateRow(Layout.RowHeight, text)
	local keybind = { Value = default }
	local isListening = false

	createLabel(row, text, {
		Size = UDim2.new(0.6, 0, 1, 0),
	})

	local button = create("TextButton", {
		Position = UDim2.new(1, -70, 0, 0),
		Size = UDim2.fromOffset(70, Layout.RowHeight),
		BackgroundTransparency = 1,
		Text = formatInputName(default),
		Font = Fonts.Regular,
		TextSize = 11,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)

	button.MouseButton1Click:Connect(function()
		isListening = true
		button.Text = "[...]"
		button.TextColor3 = Theme.Accent
	end)

	local function tryBind(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode ~= Enum.KeyCode.Escape then
				keybind.Value = input.KeyCode
			end
			return true
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			keybind.Value = input.UserInputType
			return true
		end
		return false
	end

	window:Connect(UserInputService.InputBegan, function(input, processed)
		if isListening then
			if tryBind(input) then
				isListening = false
				button.Text = formatInputName(keybind.Value)
				button.TextColor3 = Theme.Muted
				if onChanged then
					onChanged(keybind.Value)
				end
			end
			return
		end

		local matchesKey = input.KeyCode == keybind.Value or input.UserInputType == keybind.Value
		if not processed and matchesKey and callback then
			callback()
		end
	end)

	return keybind
end

function Section:AddTextbox(text, placeholder, callback)
	local row = self:CreateRow(Layout.RowHeight, text)
	local textbox = { Value = "" }

	createLabel(row, text, {
		Size = UDim2.new(0.4, 0, 1, 0),
	})

	local box = create("TextBox", {
		Position = UDim2.new(1, -120, 0, 4),
		Size = UDim2.fromOffset(120, 22),
		BackgroundColor3 = Theme.Control,
		Text = "",
		PlaceholderText = placeholder or "",
		PlaceholderColor3 = Theme.Muted,
		TextColor3 = Theme.Text,
		Font = Fonts.Regular,
		TextSize = 12,
		ClearTextOnFocus = false,
		BorderSizePixel = 0,
	}, row)
	addCorner(box, 4)
	addPadding(box, 0, 0, 6, 6)

	function textbox:Set(value)
		self.Value = value
		box.Text = value
		if callback then
			callback(value)
		end
	end

	box.FocusLost:Connect(function()
		textbox.Value = box.Text
		if callback then
			callback(box.Text)
		end
	end)

	return textbox
end

return Library
