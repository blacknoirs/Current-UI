local function openDropdownList(window, anchor, options, selected, onSelect)
	local overlay = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 50,
	}, window.Main)

	local scale = window.Scale.Scale
	local offsetX = (anchor.AbsolutePosition.X - window.Main.AbsolutePosition.X + anchor.AbsoluteSize.X) / scale - Layout.DropdownWidth
	local offsetY = (anchor.AbsolutePosition.Y - window.Main.AbsolutePosition.Y + anchor.AbsoluteSize.Y) / scale - 4

	local list = create("Frame", {
		Position = UDim2.fromOffset(offsetX, offsetY),
		Size = UDim2.fromOffset(Layout.DropdownWidth, #options * Layout.DropdownItemHeight + 8),
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		ZIndex = 51,
	}, overlay)
	addCorner(list)
	addStroke(list, Theme.Control)

	for index, option in ipairs(options) do
		local item = create("TextButton", {
			Position = UDim2.fromOffset(0, 4 + (index - 1) * Layout.DropdownItemHeight),
			Size = UDim2.new(1, 0, 0, Layout.DropdownItemHeight),
			BackgroundTransparency = 1,
			Text = option,
			Font = Fonts.Regular,
			TextSize = 12,
			TextColor3 = option == selected and Theme.Accent or Theme.Text,
			ZIndex = 52,
		}, list)

		item.MouseEnter:Connect(function()
			tween(item, { TextColor3 = Theme.White }, 0.1)
		end)
		item.MouseLeave:Connect(function()
			tween(item, { TextColor3 = option == selected and Theme.Accent or Theme.Text }, 0.1)
		end)
		item.MouseButton1Click:Connect(function()
			overlay:Destroy()
			onSelect(option)
		end)
	end

	overlay.MouseButton1Click:Connect(function()
		overlay:Destroy()
	end)
end

function Library:CreateWindow(options)
	options = options or {}

	local window = setmetatable({
		Tabs = {},
		ActiveTab = nil,
		Sections = {},
		Connections = {},
		ToggleKey = options.Key or options.ToggleKey or Enum.KeyCode.RightShift,
		ScaleMultiplier = options.Scale or 1,
		AutoScale = options.AutoScale ~= false,
	}, Window)

	window.Gui = create("ScreenGui", {
		Name = "UILibrary",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))

	window.Main = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(Layout.WindowWidth, Layout.WindowHeight),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, window.Gui)
	addCorner(window.Main, 6)
	addStroke(window.Main)

	window.Scale = create("UIScale", { Scale = 1 }, window.Main)

	window:BuildScaling()
	window:BuildTopBar(options)
	window:BuildSidebar(options)
	window:BuildWatermark(options)
	window:BuildNotifications()
	window:BuildToggleButton(options)
	window:EnableDragging()
	window:EnableToggleKey()

	return window
end

function Window:Connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.Connections, connection)
	return connection
end

function Window:UpdateScale()
	local viewport = self.Gui.AbsoluteSize
	if viewport.X == 0 or viewport.Y == 0 then
		return
	end

	local scale = self.ScaleMultiplier
	if self.AutoScale then
		local fitX = viewport.X / (Layout.WindowWidth + Layout.ScreenMargin * 2)
		local fitY = viewport.Y / (Layout.WindowHeight + Layout.ScreenMargin * 2)
		scale = math.max(math.min(scale, fitX, fitY), Layout.MinScale)
	end

	self.Scale.Scale = scale
end

function Window:BuildScaling()
	self:Connect(self.Gui:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:UpdateScale()
	end)
	self:UpdateScale()
end

function Window:SetScale(multiplier)
	self.ScaleMultiplier = multiplier
	self:UpdateScale()
end

