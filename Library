function Window:BuildWatermark(options)
	local config = options.Watermark
	if config == false then
		return
	end
	config = config or {}

	local title = options.Title or "ui"
	local prefix = config.Prefix or (title:sub(1, 1):upper() .. title:sub(2))
	local suffix = config.Suffix or ""
	local palette = config.Colors or Theme.Gradient

	local gradients = {}
	local glowStrokes = {}

	local function addGradient(parent)
		table.insert(gradients, create("UIGradient", {}, parent))
	end

	self.Watermark = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 18, 0.5, 30),
		Size = UDim2.fromOffset(160, 24),
		BackgroundTransparency = 1,
		ZIndex = 10,
	}, self.Main)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, self.Watermark)

	local function createWatermarkText(text, gradientText)
		local label = create("TextLabel", {
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Text = text,
			Font = Fonts.Medium,
			TextSize = 17,
			TextColor3 = Theme.White,
			ZIndex = 10,
		}, self.Watermark)

		local glow = create("UIStroke", {
			Color = Theme.White,
			Thickness = 2,
			Transparency = 0.6,
		}, label)

		table.insert(glowStrokes, glow)
		addGradient(glow)
		if gradientText then
			addGradient(label)
		end
	end

	createWatermarkText(prefix, true)
	if suffix ~= "" then
		createWatermarkText(suffix, config.GradientSuffix == true)
	end

	local elapsed = 0
	self:Connect(RunService.Heartbeat, function(deltaTime)
		if not self.Main.Visible or not self.Watermark.Visible then
			return
		end

		elapsed += deltaTime
		local shift = elapsed * 0.12
		local sequence = ColorSequence.new({
			ColorSequenceKeypoint.new(0, samplePalette(palette, shift)),
			ColorSequenceKeypoint.new(0.5, samplePalette(palette, shift + 0.17)),
			ColorSequenceKeypoint.new(1, samplePalette(palette, shift + 0.34)),
		})

		for _, gradient in ipairs(gradients) do
			gradient.Color = sequence
		end

		local pulse = 0.55 + math.sin(elapsed * 2.2) * 0.15
		for _, glow in ipairs(glowStrokes) do
			glow.Transparency = pulse
		end
	end)
end

