	}, window.Main)
	addPadding(page.Frame, 10, 10, 0, 0)

	page.LeftColumn = createColumn(page.Frame, 0, 1, -10)
	page.RightColumn = createColumn(page.Frame, 0.5, 5, -17)

	table.insert(self.Pages, page)
	self.ActivePage = self.ActivePage or page

	page.Button.MouseButton1Click:Connect(function()
		self.ActivePage = page
		window:Refresh()
	end)

	window:Refresh()
	return page
end

function Page:AddSection(title, side)
	local parent = side == "Right" and self.RightColumn or self.LeftColumn

	local section = setmetatable({
		Window = self.Window,
		Title = title:lower(),
		Rows = {},
	}, Section)

	section.Frame = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
	}, parent)
	addCorner(section.Frame, 5)
	addStroke(section.Frame)
	addPadding(section.Frame, 6, 8, 16, 15)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, section.Frame)

	createLabel(section.Frame, title, {
		Size = UDim2.new(1, 0, 0, Layout.CardTitleHeight),
		Font = Fonts.Medium,
		TextSize = 13,
		TextColor3 = Theme.White,
	})

	table.insert(self.Window.Sections, section)
	return section
end

function Section:CreateRow(height, searchText)
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
	}, self.Frame)
	table.insert(self.Rows, {
		Frame = row,
		Text = searchText:lower(),
	})
	return row
end

function Section:AddLabel(text)
